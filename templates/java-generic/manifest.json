{
  "manifest_version": "agent-manifest/v1",
  "agent_id": "{{agent_id}}",
  "version": "0.1.0",
  "execution_protocols": [
    "agent-execution/v2"
  ],
  "capabilities": [
    "invoke",
    "run",
    "resume",
    "cancel",
    "events"
  ],
  "schemas": {
    "input": "schema://{{agent_id}}/input/v1",
    "output": "schema://{{agent_id}}/output/v1",
    "event": "schema://agent-platform/event/v1",
    "checkpoint": "schema://agent-platform/checkpoint/v1"
  },
  "runtime": {
    "transport": "http",
    "isolation": "container",
    "health_path": "/health/ready"
  },
  "metadata": {
    "template_id": "java-generic",
    "template_version": "1.1.0",
    "sdk_capabilities_version": "2.1.0"
  }
}
