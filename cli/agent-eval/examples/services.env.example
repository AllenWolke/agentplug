# Copy to .local-secrets/agent-eval/services.env and fill actual public IDs.
# Secrets belong in individually scoped read-only files, not this env file.
AGENT_EVAL_NETWORK=agentplug_default
AGENT_EVAL_PLATFORM_CONTAINER=agentplug-platform-app-1
AGENT_EVAL_CAPABILITY_URL=http://platform-app:8081
AGENT_EVAL_SERVICE_SECRET_DIR=/absolute/private/evaluation-services
AGENT_EVAL_FIXTURE_CLIENT_ID=replace-with-fixture-workload-client
AGENT_EVAL_JUDGE_CLIENT_ID=replace-with-grading-workload-client
