                "kind": "problem",
                "name": "Identical operands",
                "precision": "very-high",
                "problem.severity": "warning"
              }
            },
            {
              "id": "go/redundant-recover",
              "name": "go/redundant-recover",
              "shortDescription": {
                "text": "Redundant call to recover"
              },
              "fullDescription": {
                "text": "Calling 'recover' in a function which isn't called using a defer statement has no effect. Also, putting 'recover' directly in a defer statement has no effect."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
