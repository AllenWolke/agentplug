{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent verdict formula v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "metric_id"],
  "properties": {
    "version": {"const": "independent-verdict/v1"},
