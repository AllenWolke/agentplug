{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexagent.local/contracts/model-governance/v1/deployment.schema.json",
  "title": "Model Deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_version_id", "environment", "endpoint_ref", "runtime_kind", "min_replicas", "max_replicas"],
  "properties": {
    "model_version_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1, "maxLength": 32},
    "endpoint_ref": {"type": "string", "minLength": 1, "maxLength": 255},
    "runtime_kind": {"type": "string", "minLength": 1, "maxLength": 32},
    "min_replicas": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_replicas": {"type": "integer", "minimum": 1, "maximum": 1000},
    "resource_profile": {"type": "object"},
    "capacity": {"type": "object"}
  }
}
