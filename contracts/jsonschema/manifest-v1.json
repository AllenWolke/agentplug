{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://agent-platform/manifest/v1",
  "title": "Agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "agent_id", "version", "execution_protocols", "capabilities", "schemas", "runtime"],
  "properties": {
    "manifest_version": {"const": "agent-manifest/v1"},
    "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "execution_protocols": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["agent-execution/v2", "grpc-agent-execution/v2"]}
    },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["invoke", "run", "events", "cancel", "resume", "artifacts"]}
    },
    "schemas": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "output", "event", "checkpoint"],
      "properties": {
        "input": {"type": "string", "pattern": "^schema://"},
        "output": {"type": "string", "pattern": "^schema://"},
        "event": {"type": "string", "pattern": "^schema://"},
        "checkpoint": {"type": "string", "pattern": "^schema://"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["transport", "isolation"],
      "properties": {
        "transport": {"enum": ["http", "grpc", "process", "sidecar"]},
        "isolation": {"enum": ["trusted-in-process", "container", "sidecar", "sandbox"]},
        "health_path": {"type": "string", "pattern": "^/"}
      }
    }
  }
}
