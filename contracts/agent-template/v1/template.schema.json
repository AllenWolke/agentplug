{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexagent.local/contracts/agent-template/v1/template.schema.json",
  "title": "Agent template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "version", "language", "ownership", "files"],
  "properties": {
    "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "language": {"type": "string", "enum": ["python", "go", "java"]},
    "framework": {"type": "string", "maxLength": 64},
    "ownership": {"type": "string", "enum": ["template-managed", "generated"]},
    "files": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
