{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-inventory/v1",
  "description": "只读 Inspector 对存量 Agent 的盘点报告；由 cli/agentctl internal/inspect 产出。",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "root", "language", "files", "findings"],
  "properties": {
    "inventory_version": {"type": "string", "const": "agent-inventory/v1"},
    "root": {"type": "string"},
    "agent_id": {"type": "string"},
    "language": {"type": "string"},
    "framework": {"type": "string"},
    "files": {"type": "array", "items": {"type": "string"}},
    "skipped": {"type": "array", "items": {"type": "string"}},
    "suggested_adapter": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "summary"],
        "properties": {
          "code": {"type": "string"},
          "status": {"type": "string", "enum": ["confirmed", "declared", "unknown", "failed", "not_applicable"]},
          "summary": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "read_errors": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
