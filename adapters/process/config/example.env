APP_ENV=development
PROCESS_COMMAND=/opt/registered-agent/entrypoint
PROCESS_ARGS_JSON=[]
PROCESS_WORKDIR=/var/lib/registered-agent
PROCESS_ENV_JSON=[]

# Mandatory isolation envelope. The adapter refuses to start when any bound is
# missing, so a deployment can never degrade into an unisolated process run.
# PROCESS_SANDBOX_NETWORK is "none" when the adapter must create an empty
# network namespace itself (requires CAP_SYS_ADMIN) or "container" when the
# enclosing container runtime and its NetworkPolicy own network isolation.
# 必填的隔离信封：任一上限缺失即拒绝启动，部署不可能退化成无隔离执行。
# PROCESS_SANDBOX_NETWORK 为 "none" 表示由 Adapter 自行创建空网络命名空间（需要
# CAP_SYS_ADMIN），为 "container" 表示由外层容器运行时及其 NetworkPolicy 负责网络隔离。
PROCESS_SANDBOX_MEMORY_BYTES=268435456
PROCESS_SANDBOX_CPU_SECONDS=30
PROCESS_SANDBOX_MAX_PROCESSES=64
PROCESS_SANDBOX_MAX_OUTPUT_BYTES=1048576
PROCESS_SANDBOX_TIMEOUT_SECONDS=30
PROCESS_SANDBOX_NETWORK=container
# Set to "true" to fail closed unless the container cgroup memory limit is set
# and no larger than PROCESS_SANDBOX_MEMORY_BYTES.
PROCESS_SANDBOX_REQUIRE_CGROUP_MEMORY=true
