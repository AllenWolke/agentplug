APP_ENV=development
SIDECAR_UPSTREAM_URL=https://registered-agent.example.com

# Mutual TLS is mandatory: the sidecar presents its own workload identity to the
# registered upstream. Server verification is never disabled. An optional CA file
# pins the upstream trust anchor; without it the system pool is used.
# 双向 TLS 是强制的：Sidecar 向已登记上游出示自身工作负载身份，服务端校验永不关闭。
# 可选 CA 文件用于固定上游信任锚；未提供时使用系统信任库。
SIDECAR_MTLS_CERT_FILE=/etc/lexagent/tls/tls.crt
SIDECAR_MTLS_KEY_FILE=/etc/lexagent/tls/tls.key
SIDECAR_MTLS_CA_FILE=/etc/lexagent/tls/ca.crt

# Registering an events path advertises (and relays) the events capability.
# Leaving it empty keeps the sidecar from advertising a stream it cannot serve;
# cancel/resume/checkpoint are always refused with UNSUPPORTED_CAPABILITY.
# 登记事件路径即宣告并转发 events 能力；留空则 Sidecar 不会宣告它无法提供的事件流；
# cancel/resume/checkpoint 始终以 UNSUPPORTED_CAPABILITY 拒绝。
SIDECAR_EVENTS_PATH=/events
