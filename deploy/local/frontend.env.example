# 浏览器网关独立配置 / Native browser gateway configuration.
# 复制为 .local-secrets/local/frontend.env；不附带数据库或执行私钥。
# No database credentials or execution private keys belong here.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:33000
PLATFORM_URL=http://127.0.0.1:8080
# 必须匹配平台 BROWSER_GATEWAY_TOKEN。 / Match platform BROWSER_GATEWAY_TOKEN.
PLATFORM_GATEWAY_TOKEN=replace-with-independent-random-gateway-token
FRONTEND_AUTH_MODE=local
# 使用独立随机签名密钥，重启后保持令牌校验一致。 / Independent stable token signing secret.
ACCESS_TOKEN_SIGNING_KEY=
# Production: use oidc, a trusted internal proxy endpoint and its actual HTTPS issuer.
OIDC_PROXY_TRUSTED=false
OIDC_PROXY_AUTH_URL=
OIDC_ISSUER_URL=
OIDC_STEP_UP_CLIENT_ID=
OIDC_STEP_UP_CLIENT_SECRET=
OIDC_STEP_UP_REDIRECT_URL=
OIDC_AUTH_URL=
COOKIE_SECURE=false
DEPLOYMENT_PROFILE=local-host
# 历史 demo 模式专用，当前 local 登录不使用。 / Only legacy demo mode uses this.
DEMO_PASSWORD_SYSTEM_ADMIN=
