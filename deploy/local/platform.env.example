# 主机平台进程 / Native platform process. Values are literal, not shell expressions.
# 只复制为 .local-secrets/local/platform.env；不要使用根 Compose .env。
# Read docs/developer/en/deployment.md and configuration.md for variable mapping.
APP_ENV=development
DB_DRIVER=pgx
# 平台 DML 连接；迁移连接只放 migration.env。 / DML only; migration has its own file.
DB_DSN=postgresql://platform_runtime:replace-with-independent-strong-password@127.0.0.1:5432/agentplug?sslmode=disable
PLATFORM_HTTP_ADDR=127.0.0.1:8080
PLATFORM_INTERNAL_ADDR=127.0.0.1:8081
# 下列凭据独立生成，Runner token 与 runner.env 对应；不向 Agent 下发。
# Independent service secrets. Match the Runner secret, never distribute these to agents.
INTERNAL_TOKEN=replace-internal-token
BROWSER_GATEWAY_TOKEN=replace-with-independent-random-gateway-token
INTERNAL_SIGNING_SECRET=replace-signing-secret
# 匹配 Ed25519 raw Base64 公私钥；业务 Agent 只有公钥。
# Matching raw Base64 Ed25519 pair; agents receive only the public key.
PLATFORM_CONTEXT_PUBLIC_KEY=replace-ed25519-public-key
PLATFORM_CONTEXT_PRIVATE_KEY=replace-ed25519-private-key
PLATFORM_CONTEXT_ISSUER=platform
PLATFORM_CONTEXT_AUDIENCE=agent-runtime
PLATFORM_RUN_EXECUTOR=platform
PLATFORM_POLICY_RESOLVER=sql
# 自己建立首位管理员，不启用历史演示账号。 / Bootstrap your administrator; no demo seeds.
PLATFORM_DEMO_IDENTITY_BOOTSTRAP=false
PLATFORM_CONVERSATION_ERASURE_ENABLED=true
PLATFORM_METRIC_RUNNER_URL=http://127.0.0.1:8085
PLATFORM_METRIC_RUNNER_TOKEN=replace-runner-token
PLATFORM_CAPABILITY_URL=http://127.0.0.1:8081
# 开发可关闭事件；启用 Kafka / 知识 / 生产时要配置实际依赖。
# Disabled for native onboarding; configure actual Kafka / knowledge / production dependencies.
EVENT_BUS_MODE=disabled
PLATFORM_NOTIFICATION_ADAPTER=none
