# 一次性迁移配置 / One-shot migration configuration; never give to runtime services.
APP_ENV=development
DB_DRIVER=pgx
DB_DSN=postgresql://schema_owner:replace-with-independent-strong-password@127.0.0.1:5432/agentplug?sslmode=disable
# 本地为 platform_runtime 预置密码；生产 DBA 预置角色后显式留空。
# Local role provisioning; explicitly empty in production after DBA-managed provisioning.
PLATFORM_DEV_RUNTIME_PASSWORD=replace-runtime-password
