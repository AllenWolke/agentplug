# AgentPlug 本地 Docker 开发配置 / Local Docker development configuration
# 首次使用：python scripts/prepare_local_development.py 自动生成必需凭据。
# First use: prepare_local_development.py generates required credentials.
# 阅读 docs/developer/zh/configuration.md 或 docs/developer/en/configuration.md。
# 不把本文件直接当生产配置；占位值不能用于真实部署。
# Do not use template placeholders as credentials or treat this as a production profile.
# 主机进程使用 deploy/local/*.env.example；K8s 使用 ConfigMap / external Secrets。

# 首次启动：由准备命令生成或保留默认
# First startup: generated credentials and safe defaults
# 运行模式；本地 development，生产必须 production。
# Runtime mode; development locally, production in production.
APP_ENV=development
# 数据库驱动；保持 pgx。
# Database driver; keep pgx.
DB_DRIVER=pgx
# Compose 自建 PostgreSQL 的初始化管理员密码；独立随机值。
# Initial owner password for Compose PostgreSQL; independent random value.
DB_PASSWORD=replace-with-random-postgres-owner-password
# 平台 DML 账号密码；不同于迁移 / 数据库管理员。
# Platform DML-role password; distinct from the owner / migration account.
PLATFORM_RUNTIME_DB_PASSWORD=replace-with-independent-random-runtime-password
# 平台内部服务认证；不下发给业务 Agent。
# Platform internal service authentication; do not distribute to agents.
INTERNAL_TOKEN=dev-internal-token
# 浏览器网关的独立认证密钥；不能与 INTERNAL_TOKEN 共用。
# Independent browser gateway secret; must differ from INTERNAL_TOKEN.
BROWSER_GATEWAY_TOKEN=
# 平台与隔离评测 Runner 之间的独立认证密钥。
# Independent platform-to-isolated-runner credential.
METRIC_RUNNER_TOKEN=replace-with-a-random-32-byte-token
# 内部请求 HMAC 与评测证据签名；独立随机值。
# Internal request HMAC and evaluation evidence signing; independent random value.
INTERNAL_SIGNING_SECRET=dev-internal-signing-secret
# 执行上下文 Ed25519 公钥；Agent 只持公钥。
# Execution-context Ed25519 public key; agents receive only the public half.
PLATFORM_CONTEXT_PUBLIC_KEY=
# 执行上下文 Ed25519 私钥；仅平台持有，必须与公钥匹配。
# Execution-context Ed25519 private key; platform only, matching the public key.
PLATFORM_CONTEXT_PRIVATE_KEY=
# 浏览器访问令牌的稳定签名密钥；随机生成，不是执行私钥。
# Stable browser access-token signing secret; separate from execution keys.
ACCESS_TOKEN_SIGNING_KEY=
# 控制台主机端口；默认 3000。
# Console host port; default 3000.
FRONTEND_HOST_PORT=3000
# 数据库主机端口；默认 5432。
# Database host port; default 5432.
POSTGRES_HOST_PORT=5432
# 平台业务 HTTP 主机端口；默认 38082。
# Platform HTTP host port; default 38082.
PLATFORM_HOST_PORT=38082
# 内部能力主机端口；默认 38083，始终回环绑定。
# Internal capability host port; default 38083, loopback-bound.
PLATFORM_INTERNAL_HOST_PORT=38083
# 平台公开端口绑定地址；本地保留 127.0.0.1。
# Platform host bind; keep 127.0.0.1 locally.
PLATFORM_HOST_BIND=127.0.0.1
# 控制台绑定地址；本地保留 127.0.0.1。
# Console bind; keep 127.0.0.1 locally.
FRONTEND_HOST_BIND=127.0.0.1
# 身份方式；local 为本地密码，oidc 为可信身份代理。
# Authentication mode; local passwords or trusted oidc proxy.
FRONTEND_AUTH_MODE=local
# 仅 HTTPS 发送 Cookie；本地 HTTP false，生产 HTTPS true。
# Send cookies over HTTPS only; false for local HTTP, true for production HTTPS.
COOKIE_SECURE=false
# 演示身份种子开关；自己的空库账号使用 false，生产禁止 true。
# Demo identity seeding; false for your own accounts, true forbidden in production.
PLATFORM_DEMO_IDENTITY_BOOTSTRAP=false

# 数据库部署与迁移：自建 Compose 通常留空
# Database and migration: usually empty for local Compose
# PLATFORM_DEV_RUNTIME_PASSWORD 未设置时，本地 init 使用运行密码创建角色。
# 生产 DBA 预置角色后，显式设置 PLATFORM_DEV_RUNTIME_PASSWORD= 禁止开发角色初始化。
# 覆盖平台运行连接；空值使用 Compose platform_runtime 连接。
# Override platform runtime DSN; empty selects the Compose platform_runtime connection.
PLATFORM_DB_DSN=
# 覆盖迁移连接；空值使用 Compose owner，生产使用独立迁移账号。
# Override migration DSN; empty selects the Compose owner; use a separate migration role in production.
PLATFORM_MIGRATION_DB_DSN=
# 平台知识投影 PostgreSQL 连接；知识接入 / 生产需配置，不给 Agent。
# Platform knowledge projection PostgreSQL connection; required for knowledge / production, never for agents.
KNOWLEDGE_DATABASE_DSN=

# Agent 和模型接入：完成基础启动后再配置
# Agents and models: configure after base startup
# 执行签名 audience；与 Agent 校验配置一致。
# Execution signature audience; must match agent verification settings.
PLATFORM_CONTEXT_AUDIENCE=agent-runtime
# 实际执行器；默认 platform，disabled 仅用于明确的隔离场景。
# Run executor; platform by default, disabled only for explicit isolation.
PLATFORM_RUN_EXECUTOR=platform
# 当前发布策略来源；正常使用 sql。
# Published policy resolver; use sql for normal operation.
PLATFORM_POLICY_RESOLVER=sql
# service:// 引用到真实模型端点的运维白名单 JSON；不包含 API Key。
# Operator JSON allowlist mapping service:// references to model endpoints; no API keys.
PLATFORM_MODEL_ENDPOINTS_JSON=
# 宿主机模型密钥目录；只读挂载到平台。
# Host model-secret directory mounted read-only into the platform.
PLATFORM_MODEL_SECRET_DIR=./.local-secrets/model-providers
# 非 Compose 进程的模型密钥解析根目录；根 Compose 固定为 /run/secrets/model-providers。
# Model-secret root for non-Compose processes; root Compose fixes /run/secrets/model-providers.
PLATFORM_MODEL_SECRET_ROOT=/run/secrets/model-providers
# 知识索引工作负载凭据的宿主目录；不是模型供应商目录。
# Host credential directory for indexing workloads; distinct from provider secrets.
PLATFORM_WORKLOAD_SECRET_DIR=./.local-secrets/agent-workloads
# 隔离开发的直接策略注入；通常空，生产禁止。
# Direct policy injection for isolated development; normally empty, forbidden in production.
PLATFORM_POLICY_BOOTSTRAP_JSON=
# 隔离开发的 Prompt 正文映射；生产使用发布资产，禁止直接注入。
# Prompt-body map for isolated development; production uses published assets and forbids injection.
PLATFORM_PROMPT_TEMPLATES_JSON=
# 父子 Agent 预算控制；保持 true，须有对应策略预算。
# Parent/child agent budget control; keep true and configure approved budgets.
PLATFORM_RUN_TREE_BUDGET_ENABLED=true
# 根运行工作线程数；影响运行容量。
# Root-run worker count; affects execution capacity.
PLATFORM_RUN_WORKERS=4
# 每个委派深度的保留线程数；范围 1..32，受总容量约束。
# Reserved workers per delegation depth; 1..32, subject to overall limits.
PLATFORM_CHILD_RUN_WORKERS=4
# 遥测收集端点；本地可空，生产启动要求配置。
# Telemetry collector endpoint; optional locally, required for production startup.
OTEL_EXPORTER_OTLP_ENDPOINT=

# 事件与通知：本地保留默认
# Events and notifications: keep local defaults
# Compose 事件总线选择；kafka 映射到进程 EVENT_BUS_MODE。
# Compose event-bus choice; kafka maps to process EVENT_BUS_MODE.
PLATFORM_EVENT_BUS_MODE=kafka
# Kafka broker 列表；本地 kafka:9092。
# Kafka brokers; kafka:9092 in Compose.
PLATFORM_KAFKA_BROKERS=kafka:9092
# Kafka 客户端标识；不是账号。
# Kafka client identifier; not a user account.
PLATFORM_KAFKA_CLIENT_ID=lexagent-platform
# 通知消费主题。
# Notification consumer topic.
PLATFORM_KAFKA_NOTIFICATION_TOPIC=platform.audit
# 通知消费组；改变会影响消费位置。
# Notification consumer group; changes affect offsets.
PLATFORM_KAFKA_NOTIFICATION_GROUP=lexagent-platform-notification-v1
# 失败消息的死信主题。
# Dead-letter topic for failed deliveries.
PLATFORM_KAFKA_NOTIFICATION_DLQ=platform.notification-dlq.v1
# 通知投递最大尝试次数。
# Maximum notification delivery attempts.
PLATFORM_KAFKA_MAX_ATTEMPTS=5
# 通知重试间隔，Go duration 格式，例如 1s。
# Notification retry delay in Go duration syntax, for example 1s.
PLATFORM_KAFKA_RETRY_BACKOFF=1s
# 通知出口；audit 写平台审计，其他选项以进程校验为准。
# Notification adapter; audit writes platform audit, other values require runtime validation.
PLATFORM_NOTIFICATION_ADAPTER=audit
# 使用 webhook 通知时的批准端点；默认不调用外部系统。
# Approved endpoint for webhook notifications; no external call by default.
PLATFORM_NOTIFICATION_WEBHOOK_URL=

# 生产 OIDC：本地密码登录无需填写
# Production OIDC: unnecessary for local password login
# 是否信任经过部署验证的内部 OIDC 代理；不可无条件启用。
# Trust a deployment-verified internal OIDC proxy; do not enable blindly.
OIDC_PROXY_TRUSTED=false
# 内部代理认证检查地址。
# Internal proxy authentication-check URL.
OIDC_PROXY_AUTH_URL=
# 真实 IdP issuer，须匹配平台身份绑定。
# Real IdP issuer matching platform identity bindings.
OIDC_ISSUER_URL=
# 浏览器登录跳转入口。
# Browser login redirect entry point.
OIDC_AUTH_URL=
# 再次认证 OIDC 客户端 ID；与后两项一起配置。
# Fresh-authentication OIDC client ID; configure together with the following two fields.
OIDC_STEP_UP_CLIENT_ID=
# 再次认证客户端密钥；仅网关持有。
# Fresh-authentication client secret; gateway only.
OIDC_STEP_UP_CLIENT_SECRET=
# IdP 登记的 HTTPS 再认证回调 /auth/step-up/oidc/callback。
# Registered HTTPS callback ending /auth/step-up/oidc/callback.
OIDC_STEP_UP_REDIRECT_URL=

# 可选扩展与运维：按需启用
# Optional extensions and operations: opt in when needed
# 会话擦除工作器开关；受控恢复期间暂停并核对队列。
# Conversation erasure worker; pause and reconcile during controlled restoration.
PLATFORM_CONVERSATION_ERASURE_ENABLED=true
# 取消补偿扩展的显式启用开关；基础栈不自动加入补偿服务。
# Explicit cancellation-compensation rollout; base stack does not add compensation services.
PLATFORM_CANCELLATION_COMPENSATION_ENABLED=false
# 可逆 API 绑定文件的容器路径；仅相应扩展使用。
# Container path to reversible API bindings; consumed by the relevant extension.
PLATFORM_REVERSIBLE_API_BINDINGS_FILE=
# 可逆 API TLS CA 文件；需配套私有挂载。
# Reversible API TLS CA file; requires private mounts.
PLATFORM_REVERSIBLE_API_CA_FILE=
# 指定历史预留进行对账；需要原供应商证据，不允许重发。
# Selected historical reservations for accounting; original evidence required, no resend.
PLATFORM_LEGACY_MODEL_ACCOUNTING_RESERVATIONS=
# 宿主 MCP 适配配置目录；默认模板目录。
# Host MCP binding directory; defaults to the template directory.
PLATFORM_MCP_BINDINGS_DIR=./deploy/mcp
# 启用 MCP 的容器配置路径；空值关闭。
# Container MCP configuration path; empty disables MCP.
PLATFORM_MCP_BINDINGS_FILE=
# Code Runtime 控制器固定私网 IP；基础启动不需要。
# Fixed private Code Runtime controller IP; not needed for base startup.
CODE_RUNTIME_PRIVATE_IP=
# Code Runtime 专用网段；不得与已有网络重叠。
# Dedicated Code Runtime subnet; must not overlap existing networks.
CODE_RUNTIME_SUBNET=
# 实际 Docker socket 的组 ID；不能按操作系统猜测。
# Actual Docker socket group ID; do not guess from the OS.
CODE_RUNTIME_DOCKER_SOCKET_GID=
# 经审查的 Docker CLI 镜像引用 / 摘要。
# Reviewed Docker CLI image reference / digest.
CODE_RUNTIME_DOCKER_CLI_IMAGE=
# full 栈 MinIO 的独立密钥；默认 modular 不启用 MinIO。
# Independent MinIO credential for full stack; modular does not enable MinIO.
EVALUATION_ARTIFACT_S3_SECRET_KEY=
# 旧演示登录密码；local 模式与首位管理员流程不使用。
# Legacy demo-login password; unused by local first-administrator initialization.
DEMO_PASSWORD_SYSTEM_ADMIN=

# 历史兼容参数：当前基础栈不读取，首次部署无需填写
# Legacy compatibility: not read by the current base stack
# 历史 API Key 参数；不能开启当前浏览器或 Agent 认证。
# Historical API-key variable; does not enable current browser or agent authentication.
API_KEY=dev-api-key
# 历史 OAuth 名称；不是当前执行签名配置。
# Historical OAuth name; not the active execution signing configuration.
OAUTH_ACCESS_PRIVATE_KEY=
# 历史 OAuth 文件名称；当前模块化平台不读取。
# Historical OAuth file variable; not read by the modular platform.
OAUTH_ACCESS_PRIVATE_KEY_FILE=
# 历史 credit 客户端标识；当前基础栈不读取。
# Historical credit client ID; not read by the base stack.
CREDIT_SYSTEM_CLIENT_ID=credit-system
# 历史 credit 客户端密钥；当前基础栈不读取。
# Historical credit client secret; not read by the base stack.
CREDIT_SYSTEM_CLIENT_SECRET=replace-with-a-long-random-secret
# 历史参数；设置它不表示当前记忆数据已经加密。
# Historical variable; setting it does not prove current memory encryption.
MEMORY_ENCRYPTION_KEY=replace-with-a-random-memory-key
# 历史 mock / provider 参数；不创建当前治理模型或策略。
# Historical mock/provider variable; does not create governed models or policies.
MODEL_PROVIDER=mock
# 历史端点参数；当前端点使用 PLATFORM_MODEL_ENDPOINTS_JSON。
# Historical endpoint; active endpoints use PLATFORM_MODEL_ENDPOINTS_JSON.
MODEL_BASE_URL=
# 历史内联密钥参数；当前模型使用平台挂载密钥引用。
# Historical inline secret; current models use mounted platform secret references.
MODEL_API_KEY=
# 历史默认模型名；不替代 ModelVersion。
# Historical default chat model; not a ModelVersion.
MODEL_CHAT_MODEL=mock-model
# 历史默认 Embedding 名；不替代批准版本。
# Historical embedding model; not an approved version.
MODEL_EMBEDDING_MODEL=mock-embedding
# 历史候选列表；当前模型目录由治理模块管理。
# Historical chat list; current model catalog is governed by the platform.
MODEL_CHAT_MODELS=mock-model
# 历史候选列表；不创建 Embedding 配置。
# Historical embedding list; does not create active embedding configuration.
MODEL_EMBEDDING_MODELS=mock-embedding
# 历史 JSON 目录；不替代模型治理 API。
# Historical JSON catalog; not a replacement for governance APIs.
MODEL_CATALOG_JSON=
# 历史超时参数；当前基础 Compose 不传入平台。
# Historical timeout; not passed to the platform by base Compose.
MODEL_TIMEOUT_SECONDS=30
# 独立 Python workflow 初始化可用；基础 Compose 不下发给业务 Agent。
# Used by separate Python workflow initialization; base Compose does not distribute it to agents.
CHECKPOINT_DSN=
# 历史 Agent worker 参数；不控制当前平台根 / 子运行线程。
# Historical agent worker variable; does not control current root/child platform workers.
AGENT_WORKER_CONCURRENCY=4
