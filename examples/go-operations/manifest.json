{
  "manifest_version": "agent-manifest/v1",
  "agent_id": "example-go-operations",
  "version": "0.2.6",
  "execution_protocols": [
    "agent-execution/v2"
  ],
  "capabilities": [
    "invoke",
    "run",
    "resume",
    "cancel",
    "events"
  ],
  "schemas": {
    "input": "schema://example-go-operations/input/v2",
    "output": "schema://example-go-operations/output/v2",
    "event": "schema://agent-platform/event/v1",
    "checkpoint": "schema://agent-platform/checkpoint/v1"
  },
  "runtime": {
    "transport": "http",
    "isolation": "container",
    "health_path": "/health/ready",
    "run_store": "memory-dev-only(L2/L3 forbidden)"
  },
  "metadata": {
    "sdk": "sdk/go",
    "business": "operations-diagnosis",
    "durability": "process-local-L1",
    "public_capabilities": [
      "prompt.resolve",
      "tool.invoke:runtime.inspect",
      "tool.invoke:code.python",
      "tool.invoke:notify.self",
      "knowledge.search:go-operations",
      "model.generate",
      "memory.read",
      "memory.write",
      "state.checkpoint",
      "context.prepare",
      "model.receipt",
      "skill.load:example.operations.guidance"
    ],
    "harness": "harness-loop/v1; pinned evidence/Skill; inspect function; optional sandbox_check exposes sandbox_python mapped to operator-bound tool.invoke:code.python and requires independent approval; optional notify_me exposes notify_self mapped to tool.invoke:notify.self; optional collaborate uses the fixed documents.answer AgentGroup plan and durable gather recovery; all use current IAM and public capability receipts; process-local execution transport remains L1; latest source not accepted",
    "route_task_types": [
      "operations.diagnosis"
    ]
  }
}
