{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://example-go-operations/output/v2",
  "type": "object",
  "required": ["schema", "service", "answer", "knowledge", "context_checks", "notify_me", "sandbox_check", "collaborate"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "schema://example-go-operations/output/v2"},
    "service": {"type": "string"},
    "answer": {"type": "string", "minLength": 1},
    "knowledge": {"type": "object"},
    "context_checks": {"type": "object"},
    "notify_me": {"type": "boolean", "description": "Echoes the request; it does not assert notification submission or delivery"},
    "sandbox_check": {"type": "boolean", "description": "Echoes the request; it does not assert that sandbox analysis ran or succeeded"},
    "collaborate": {"type": "boolean", "description": "Echoes the fixed collaboration selection; it does not imply cross-Agent authorization"},
    "usage": {"type": ["object", "null"]},
    "collaboration": {
      "type": "object",
      "required": ["instruction_trust", "task_type", "children"],
      "additionalProperties": false,
      "properties": {
        "instruction_trust": {"const": "untrusted_data"},
        "task_type": {"const": "documents.answer"},
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["child_key", "input_fingerprint", "output_digest", "output_schema", "question", "answer", "references", "citation_ids"],
            "additionalProperties": false,
            "properties": {
              "child_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "output_schema": {"const": "schema://example-python-documents/output/v2"},
              "question": {"type": "string", "maxLength": 8192},
              "answer": {"type": "string", "minLength": 1, "maxLength": 16384},
              "references": {"type": "array", "maxItems": 32},
              "citation_ids": {"type": "array", "maxItems": 128, "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "if": {"properties": {"collaborate": {"const": true}}, "required": ["collaborate"]},
  "then": {"required": ["collaboration"]}
}
