{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://example-java-tickets/input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "summary"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "details": {
      "type": "string",
      "maxLength": 8192
    }
  }
}
