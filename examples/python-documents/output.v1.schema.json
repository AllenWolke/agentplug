{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://example-python-documents/output/v1",
  "type": "object",
  "required": [
    "schema",
    "question",
    "answer",
    "references",
    "retrieved_ids",
    "citation_ids",
    "evaluation_citations",
    "evaluation_claims",
    "answer_cache_hit",
    "usage",
    "billing"
  ],
  "properties": {
    "schema": {
      "const": "schema://example-python-documents/output/v1"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "references": {
      "type": "array",
      "minItems": 1
    },
    "citation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "retrieved_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "evaluation_citations": {
      "type": "array",
      "minItems": 1
    },
    "evaluation_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "answer_cache_hit": {
      "type": "boolean"
    },
    "usage": {
      "type": "object"
    },
    "billing": {
      "type": "object"
    }
  }
}
