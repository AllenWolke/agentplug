{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://example-python-documents/input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3
    },
    "cache_mode": {
      "type": "string",
      "enum": [
        "use",
        "cold",
        "bypass"
      ],
      "default": "use"
    }
  }
}
